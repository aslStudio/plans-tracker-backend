                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('recurring task appears on multiple days', function () { pm.expect(pm.response.json().items.filter(x => x.task.id === pm.collectionVariables.get('recurringTaskId')).length).to.be.above(1); });"
