  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const start = new Date(now); start.setUTCDate(start.getUTCDate() - 2);",
          "const end = new Date(now); end.setUTCDate(end.getUTCDate() + 7);",
          "pm.collectionVariables.set('startDate', start.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('endDate', end.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
