{
  "info": {
    "name": "Plans Tracker — локальная проверка API",
    "_postman_id": "a54c8a23-64be-4dcc-92f2-772301b16b9d",
    "description": "Импортируйте коллекцию и запустите целиком после docker compose up --build -d. Запросы создают три справочника и связанную с ними задачу, затем удаляют справочники и проверяют переназначение связей. baseUrl указывает на локальный tasks сервис.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('service ready', function () { pm.expect(pm.response.json().status).to.eql('ready'); });"
                ]
              }
            }
          ]
        }
      ]
    },
